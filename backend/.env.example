# ULTRON AI - exemplo de configuração
# Nunca coloque chaves reais neste arquivo.

AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare,cohere

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
PUBLIC_APP_URL=

# No Cloudflare Worker, o binding AI pode ser usado sem estas duas variáveis.
# Para o backend Node local, configure-as se quiser usar Workers AI via REST.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

# Manutenção: voz, microfone e Voice Match permanentemente OFF até nova autorização.
ELEVENLABS_AUTOSPEAK=false

# Servidor Node de desenvolvimento: apenas loopback por padrão.
ULTRON_LOCAL_HOST=127.0.0.1
# Origens adicionais HTTPS, listadas por vírgula, somente se necessário.
ULTRON_LOCAL_ALLOWED_ORIGINS=
# Obrigatório se ULTRON_LOCAL_HOST for alterado para um endereço LAN/0.0.0.0.
# Gere um segredo aleatório de no mínimo 32 caracteres e nunca o envie ao frontend.
ULTRON_LOCAL_API_TOKEN=

DEVICE_BRIDGE_URL=
PORT=3000
NODE_ENV=development
