# Chave da Gemini criada no Google AI Studio.
# Configure o valor real no Cloudflare Workers, nunca no GitHub.
GEMINI_API_KEY=COLE_SUA_CHAVE_NO_CLOUDFLARE

# Opcional. Se omitido, o Worker usa gemini-3.8-flash.
Gemini 2.5 Flash Native Audio Dialog

# Chave e voz da ElevenLabs.
# Configure os valores reais no Cloudflare Workers, nunca no GitHub.
ELEVENLABS_API_KEY=COLE_SUA_CHAVE_NO_CLOUDFLARE
ELEVENLABS_VOICE_ID=COLE_O_ID_DA_VOZ_NO_CLOUDFLARE

# Opcional.
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_AUTOSPEAK=true

# Opcional.
DEVICE_BRIDGE_URL=
