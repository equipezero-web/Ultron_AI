# ULTRON AI - exemplo de configuração
# Nunca coloque chaves reais neste arquivo.

AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare,cohere

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
PUBLIC_APP_URL=

# No Cloudflare Worker, o binding AI pode ser usado sem estas duas variáveis.
# Para o backend Node local, configure-as se quiser usar Workers AI via REST.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_AUTOSPEAK=true

DEVICE_BRIDGE_URL=
PORT=3000
NODE_ENV=development
